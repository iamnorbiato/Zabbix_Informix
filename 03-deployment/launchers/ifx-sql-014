#!/bin/ksh
runtime_env="${ZABBIX_INFORMIX_RUNTIME_ENV:-/etc/zabbix-informix/runtime.env}"
[[ -r "${runtime_env}" ]] || { print -u2 "Runtime environment file not found: ${runtime_env}"; exit 1; }
. "${runtime_env}" || exit 1
if (( $# > 1 )); then
    print -u2 "Usage: $0 [target-alias-or-INFORMIXSERVER]"
    exit 1
fi

COLLECTOR="${IFX_COLLECTOR_HOME}/05-collectors/informix/sql/ifx-sql-014-top-estimated-cost.ksh"
[[ -f "${COLLECTOR}" ]] || { print -u2 "Informix SQL-014 collector not found: ${COLLECTOR}"; exit 1; }

export IFX_INFORMIXDIR IFX_INFORMIXSERVER IFX_INFORMIXSQLHOSTS IFX_CONFIG_DIR IFX_STATE_DIR IFX_CONNECT_FILE
export INFORMIXDIR="${IFX_INFORMIXDIR}"
export PATH="${INFORMIXDIR}/bin:${PATH}"
export LD_LIBRARY_PATH="${INFORMIXDIR}/lib:${INFORMIXDIR}/lib/esql${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

exec /bin/ksh "${COLLECTOR}" "$1"
