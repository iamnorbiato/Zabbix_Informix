#!/bin/ksh
RUNTIME_ENV="${ZABBIX_INFORMIX_RUNTIME_ENV:-/etc/zabbix-informix/runtime.env}"
[[ -r "${RUNTIME_ENV}" ]] || exit 1
. "${RUNTIME_ENV}" || exit 1
COLLECTOR="${IFX_COLLECTOR_HOME}/05-collectors/informix/storage/ifx-storage-011-temporary-dbspace.ksh"
[[ -f "${COLLECTOR}" ]] || exit 1
export IFX_CONFIG_DIR IFX_STATE_DIR IFX_CONNECT_FILE IFX_INFORMIXDIR IFX_INFORMIXSERVER IFX_INFORMIXSQLHOSTS
export INFORMIXDIR="${IFX_INFORMIXDIR}" INFORMIXSERVER="${IFX_INFORMIXSERVER}" INFORMIXSQLHOSTS="${IFX_INFORMIXSQLHOSTS}" PATH="${IFX_INFORMIXDIR}/bin:${PATH}" LD_LIBRARY_PATH="${IFX_INFORMIXDIR}/lib:${IFX_INFORMIXDIR}/lib/esql${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
exec /bin/ksh "${COLLECTOR}"
