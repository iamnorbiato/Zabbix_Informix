+# Execute a statement against an explicitly selected target. The existing
+# ifx_db_execute function remains available for the current single-target
+# runtime until each collector is migrated to this entry point.
+ifx_db_execute_target()
+{
+    typeset target="$1"
+    shift
+
+    if [[ -z "${target}" || $# -lt 2 ]]; then
+        print -u2 "Usage: ifx_db_execute_target <target> <database> <statement-file> [last-id]"
+        return 1
+    fi
+
+    ifx_target_load "${target}" || return 1
+    ifx_db_execute "$@"
+}

