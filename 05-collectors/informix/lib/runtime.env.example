# Informix collector runtime configuration.
# This file contains no credentials.

IFX_COLLECTOR_HOME=/opt/zabbix-informix
IFX_INFORMIXDIR=/opt/informix
IFX_INFORMIXSERVER=CHANGE_ME
IFX_INFORMIXSQLHOSTS=/opt/informix/etc/sqlhosts

IFX_CONFIG_DIR=/etc/zabbix-informix
IFX_STATE_DIR=/etc/zabbix-informix/state
IFX_CONNECT_FILE=/etc/zabbix-informix/informix-connect.sql

# Manual target catalog. Set YES when this Agent serves multiple Informix targets.
IFX_TARGET_CATALOG_FILE=/etc/zabbix-informix/targets/catalog
IFX_TARGET_REQUIRE_CATALOG=NO
